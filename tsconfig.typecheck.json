{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  // This list is deliberately narrow, not a stand-in for a repo-wide
  // "typecheck every test" config: pointing tsc at every test in
  // llm-agent / llm-agent-libs surfaces 315 pre-existing errors in tests
  // nothing has ever type-checked, which is a separate workstream. A new
  // test added to either package that needs type-checking in CI must be
  // added to this list by hand.
  "include": [
    "packages/anthropic-llm/src/__tests__/request-boundaries.test.ts",
    "packages/deepseek-llm/src/__tests__/request-boundaries.test.ts",
    "packages/ollama-embedder/src/request-boundaries.test.ts",
    "packages/ollama-llm/src/__tests__/request-boundaries.test.ts",
    "packages/openai-embedder/src/request-boundaries.test.ts",
    "packages/openai-llm/src/__tests__/request-boundaries.test.ts",
    "packages/sap-aicore-embedder/src/request-boundaries.test.ts",
    "packages/sap-aicore-llm/src/__tests__/request-boundaries.test.ts",
    "packages/llm-agent/src/llm/__tests__/provider-usage.test.ts",
    "packages/openai-llm/src/__tests__/usage.test.ts",
    "packages/anthropic-llm/src/__tests__/usage.test.ts",
    "packages/deepseek-llm/src/__tests__/usage.test.ts",
    "packages/ollama-llm/src/__tests__/usage.test.ts",
    "packages/sap-aicore-llm/src/__tests__/usage.test.ts",
    "packages/openai-embedder/src/usage.test.ts",
    "packages/ollama-embedder/src/usage.test.ts",
    "packages/sap-aicore-embedder/src/usage.test.ts",
    "packages/llm-usage/src/**/*.ts",
    "packages/llm-agent/src/resilience/usage-propagation.test.ts",
    "packages/llm-agent-libs/src/__tests__/usage-propagation.test.ts",
    "packages/llm-agent-server-libs/src/smart-agent/controller/__tests__/subagent-client-signal.test.ts",
    "packages/llm-agent-libs/src/subagent/__tests__/default-context-builder.test.ts",
    "packages/llm-agent-libs/src/__tests__/builder-context-builder-wiring.test.ts",
    "packages/llm-agent-server-libs/src/factories/__tests__/factory-execute-integration.test.ts",
    "packages/llm-agent-libs/src/__tests__/usage-propagation-components.test.ts",
    "packages/llm-agent-libs/src/coordinator/__tests__/usage-propagation.test.ts",
    "packages/llm-agent/src/interfaces/__tests__/usage.typecheck.ts",
    "packages/llm-signals/src/signals.test.ts",
    "packages/llm-agent-libs/src/coordinator/dialogue/__tests__/signals.test.ts",
    "packages/llm-agent/src/interfaces/__tests__/signals.typecheck.ts",
    "packages/llm-agent/src/interfaces/dialogue-compatibility.test.ts",
    "packages/llm-agent/src/logger/normalise-logger.test.ts",
    "packages/llm-agent/src/resilience/embedder-resilience-text-logger.test.ts",
    "packages/llm-agent-libs/src/__tests__/text-logger-di.test.ts",
    "packages/llm-agent-mcp/src/strategies/lazy-connection-strategy-text-logger.test.ts",
    "packages/openai-llm/src/__tests__/credential.test.ts",
    "packages/anthropic-llm/src/__tests__/credential.test.ts",
    "packages/deepseek-llm/src/__tests__/credential.test.ts",
