{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  // This list is deliberately narrow, not a stand-in for a repo-wide
  // "typecheck every test" config: pointing tsc at every test in
  // llm-agent / llm-agent-libs surfaces 315 pre-existing errors in tests
  // nothing has ever type-checked, which is a separate workstream. A new
  // test added to either package that needs type-checking in CI must be
  // added to this list by hand.
  "include": [
    "packages/llm-agent/src/interfaces/__tests__/collection-profile.typecheck.ts",
    "packages/llm-agent/src/interfaces/__tests__/decision-model.typecheck.ts",
    "packages/llm-agent/src/logger/__tests__/text-logger-removed.typecheck.ts",
    "packages/llm-agent/src/logger/normalise-logger.test.ts",
    "packages/llm-agent/src/resilience/embedder-resilience-text-logger.test.ts",
    "packages/llm-agent-libs/src/__tests__/text-logger-di.test.ts",
    "packages/llm-agent-mcp/src/strategies/lazy-connection-strategy-text-logger.test.ts",
    "packages/openai-llm/src/__tests__/credential.test.ts",
    "packages/anthropic-llm/src/__tests__/credential.test.ts",
    "packages/deepseek-llm/src/__tests__/credential.test.ts",
    "packages/typesafe-decision/src/__tests__/credential.test.ts",
    "packages/llm-agent-reranker/src/__tests__/fake-llm.ts",
    "packages/ollama-llm/src/__tests__/credential.test.ts",
    "packages/openai-embedder/src/__tests__/credential.test.ts",
    "packages/llm-agent-rag/src/__typechecks__/rag-resolution.ts",
    "packages/llm-agent-rag/src/__typechecks__/embedder-resolution.ts",
    "packages/llm-agent-mcp/src/servers/__tests__/credential.test.ts",
    "packages/llm-agent-server-libs/src/__typechecks__/construction-seams.ts",
    "packages/llm-agent/src/interfaces/__tests__/pipeline-context.typecheck.ts",
    "packages/llm-agent/src/interfaces/__tests__/pipeline-plugin-contract.typecheck.ts",
    "packages/llm-agent-server-libs/src/pipelines/__tests__/server-context-lookups-only.typecheck.ts",
    "packages/llm-agent/src/rag/__tests__/rag-collection-owner.typecheck.ts",
    "packages/llm-agent-rag/src/__typechecks__/rag-tool-identity.ts",
    "packages/llm-agent-server/scripts/check-models/*.ts",
    "packages/llm-agent-rag/src/__typechecks__/embedder-roles.ts",
    "packages/llm-agent-rag/src/__typechecks__/rag-implementations-moved.ts",
    "scripts/rag-eval/rag-eval.ts",
    "scripts/rag-eval/rerank-errors.ts",
    "test/repo/rag-eval-fallbacks.test.ts",
    "packages/llm-agent-libs/src/utils/__tests__/lazy.typecheck.ts",
    "packages/llm-agent-libs/src/__tests__/tool-availability-policy.typecheck.ts",
    "packages/llm-agent-libs/src/collections/__tests__/record-writer.test.ts"
  ]
}
