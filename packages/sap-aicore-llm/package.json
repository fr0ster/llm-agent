{
  "name": "@mcp-abap-adt/sap-aicore-llm",
  "version": "31.1.5",
  "description": "SAP AI Core LLM provider (ILlm) for @mcp-abap-adt/llm-agent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/sap-ai-core-foundation-provider.d.ts",
      "default": "./dist/sap-ai-core-foundation-provider.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "GPL-3.0.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -p tsconfig.json --clean",
    "test": "node --import tsx/esm --test --test-reporter=spec 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@mcp-abap-adt/anthropic-llm": "^31.1.1",
    "@mcp-abap-adt/openai-llm": "^30.14.1",
    "@sap-ai-sdk/ai-api": "^2.18.0",
    "@sap-ai-sdk/orchestration": "^2.18.0"
  },
  "devDependencies": {
    "@mcp-abap-adt/sap-aicore-auth": "^30.9.2"
  },
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/llm-agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mcp-abap-adt/interfaces-auth": "^2.1.0",
    "@mcp-abap-adt/llm-agent": "^35.0.0"
  }
}
