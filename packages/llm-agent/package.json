{
  "name": "@mcp-abap-adt/llm-agent",
  "version": "30.0.0",
  "description": "Core interfaces, types, and lightweight default implementations for LLM agent orchestration.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing/rag-filter-conformance": {
      "types": "./dist/testing/rag-filter-conformance.d.ts",
      "import": "./dist/testing/rag-filter-conformance.js",
      "default": "./dist/testing/rag-filter-conformance.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "GPL-3.0.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -p tsconfig.json --clean",
    "test": "node --import tsx/esm --test --test-reporter=spec 'src/**/*.test.ts'"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/llm-agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.9.2"
  },
  "peerDependencies": {
    "@mcp-abap-adt/interfaces-auth": "^2.1.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.0"
  }
}
