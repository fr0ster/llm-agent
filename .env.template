# Credentials: the llm-agent binary reads them by reference (llm-agent-server README → Credentials).
# An llm: entry without credentialRef uses the LLM ref; set ONE of:
LLM_API_KEY=            # openai / anthropic / deepseek
LLM_SERVICE_KEY=        # sap-ai-sdk: the SAP AI Core service-key JSON from BTP
# A section naming credentialRef: OPENAI reads OPENAI_API_KEY; RAG_STORE_* and RAG_EMBEDDER_* are the
# rag.store and rag.embedder defaults.

# OpenAI settings
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_ORG=
OPENAI_PRJ=
OPENAI_PROJECT=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) settings
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek settings
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# Read directly by the smoke-test adapter (packages/llm-agent-server/src/smoke-adapters.ts),
# not by the composition root — keep it set for `npm run smoke` even though a normal
# deployment uses LLM_API_KEY instead.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama settings
OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=llama3.2

# SAP AI SDK settings (via @sap-ai-sdk/orchestration)
SAP_AI_MODEL=gpt-4o
SAP_AI_RESOURCE_GROUP=

# LLM Provider selection
# Options: openai, anthropic, deepseek, ollama, sap-ai-sdk
LLM_PROVIDER=openai

# MCP Configuration
MCP_ENDPOINT=http://localhost:4004/mcp/stream/http
MCP_AUTH_HEADER=Basic YWxpY2U6
SAP_DESTINATION=

# Debug settings
DEBUG_LLM_REASON=false

# Debug tracing (off by default). Each writes per-step JSON files to
# DEBUG_TRACE_DIR (default ./.smart-agent-debug/), one dir per request.
# DEBUG_LLM=1         # capture LLM request+response on the inference paths (flat agent loop, tool-loop, pass-through, controller subagents)
# DEBUG_CONTROLLER=1  # controller step decisions (also prints to stderr)
# DEBUG_MCP=1         # MCP tool call args/result/timing
# DEBUG_RAG=1         # RAG recall queries + returned extracts
# DEBUG_TRACE_DIR=./.smart-agent-debug/
# Note: a trace may contain your prompt/business data — review before sharing.
